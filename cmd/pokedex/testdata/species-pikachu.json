                                                 },
                                    "version":  {
                                                    "name":  "ruby"
                                                }
                                },
                                {
                                    "flavor_text":  "This POKéMON has electricity-storing\npouches on its cheeks. These appear to\nbecome electrically charged during the\fnight while PIKACHU sleeps.\nIt occasionally discharges electricity\nwhen it is dozy after waking up.",
