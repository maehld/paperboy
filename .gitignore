/bin/
/paperboy
/paperboy.exe
# Binaries from `go build` inside a command directory.
/cmd/*/*
!/cmd/*/*.*
!/cmd/*/*/
# The plugin version travels with its source (ADR 0075).
!/cmd/*/VERSION

# Configuration with token, operator content and service state of a local
# instance (ADR 0037); the old displayd locations stay ignored.
/paperboy.yaml
/paperboy.json
/pages/
/plans/
/devices/
/displays/
/plugins/
/providers/
/icons/
/state/
# Operator-owned firmware images of a local instance (ADR 0043); the sources stay versioned.
/firmware/*
!/firmware/esphome/
/paperboy-data/
/displayd.json
/displayd-data/
.env
