/bin/
/paperboy
/paperboy.exe
# Generated by the Go workspace; the module go.sum files stay the source.
/go.work.sum
# Binaries from `go build` inside a command directory.
/server/cmd/*/*
!/server/cmd/*/*.*
!/server/cmd/*/*/
/plugins/cmd/*/*
!/plugins/cmd/*/*.*
!/plugins/cmd/*/*/
# The plugin version travels with its source (ADR 0075).
!/plugins/cmd/*/VERSION

# Configuration with token, operator content and service state of a local
# instance (ADR 0037); the old displayd locations stay ignored.
/paperboy.yaml
/paperboy.json
/pages/
/plans/
/devices/
/displays/
# Plugin programs of a local instance; the sources live in plugins/cmd/.
/plugins/*
!/plugins/cmd/
!/plugins/internal/
!/plugins/go.mod
!/plugins/go.sum
/providers/
/icons/
/state/
# Operator-owned firmware images of a local instance (ADR 0043); the sources stay versioned.
/firmware/*
!/firmware/esphome/
/paperboy-data/
/displayd.json
/displayd-data/
.env

# Test tooling only.
node_modules/
